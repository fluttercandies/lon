{
  "name": "lon",
  "displayName": "LON",
  "description": "Syntax highlighting and language configuration for Language Object Notation (LON v1).",
  "version": "0.1.0",
  "publisher": "iota9star",
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fluttercandies/lon",
    "directory": "editors/vscode"
  },
  "contributes": {
    "languages": [
      {
        "id": "lon",
        "aliases": [
          "LON",
          "Language Object Notation",
          "lon"
        ],
        "extensions": [
          ".lon"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lon",
        "scopeName": "source.lon",
        "path": "./syntaxes/lon.tmLanguage.json"
      }
    ]
  }
}
